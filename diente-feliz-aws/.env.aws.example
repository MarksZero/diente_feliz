# Copy to .env on the server. Fill empty values; never upload a completed .env.
APP_NAME="Diente Feliz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=
APP_URL=
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
TRUSTED_PROXIES=172.30.42.10
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=diente_feliz
DB_USERNAME=clinic_app
DB_PASSWORD=
DB_SSLMODE=verify-full
PGSSLROOTCERT=/run/certs/global-bundle.pem
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Do not activate the scheduler until a real mail transport has been tested.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Diente Feliz"
